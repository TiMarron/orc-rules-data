{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "background.schema.json",
  "type": "object",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/envelope" },
    {
      "type": "object",
      "required": ["boosts", "skills"],
      "properties": {
        "type": { "const": "background" },
        "boosts": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/boost" },
          "minItems": 1,
          "maxItems": 3,
          "$comment": "Two for an ordinary background. The rare ones print what they print: the feral child one, the amnesiac three."
        },
        "skills": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/refSkill" },
          "maxItems": 2,
          "$comment": "The skills the background trains outright: one for an ordinary background, none for one that trains a skill only through `choices` or trains none at all, two for the feral child."
        },
        "choices": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["count", "from"],
                "properties": {
                  "count": { "type": "integer", "minimum": 1 },
                  "from": {
                    "type": "array",
                    "items": { "$ref": "common.schema.json#/$defs/refSkill" },
                    "minItems": 2,
                    "uniqueItems": true
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["text"],
                "properties": {
                  "text": { "$ref": "common.schema.json#/$defs/i18nKey" },
                  "count": { "type": "integer", "minimum": 1 }
                }
              }
            ]
          }
        },
        "lore": {
          "$ref": "common.schema.json#/$defs/i18nKey",
          "$comment": "The Lore skill the background trains. Absent when the book prints none, as for several rare backgrounds."
        },
        "feat": {
          "$ref": "common.schema.json#/$defs/refFeat",
          "$comment": "The skill feat the background gives. Absent when the book prints none. A second feat is a `grants` entry."
        },
        "grants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "text"],
            "properties": {
              "name": { "$ref": "common.schema.json#/$defs/i18nKey" },
              "text": { "$ref": "common.schema.json#/$defs/i18nKey" },
              "item": { "$ref": "common.schema.json#/$defs/refItem" },
              "feat": { "$ref": "common.schema.json#/$defs/refFeat" },
              "spell": { "$ref": "common.schema.json#/$defs/refSpell" }
            }
          },
          "$comment": "What the background gives beyond boosts, skills, a Lore and its one feat, in the shape of an ancestry's `grants`: an ability printed in the background itself (a reaction, a free action, senses), a further feat (`feat`), an innate spell (`spell`) or an item (`item`)."
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
