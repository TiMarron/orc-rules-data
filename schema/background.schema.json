{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "background.schema.json",
  "type": "object",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/envelope" },
    {
      "type": "object",
      "required": ["boosts", "skills", "lore", "feat"],
      "properties": {
        "type": { "const": "background" },
        "boosts": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/boost" },
          "minItems": 2,
          "maxItems": 2
        },
        "skills": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/refSkill" },
          "maxItems": 1
        },
        "choices": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["count", "from"],
                "properties": {
                  "count": { "type": "integer", "minimum": 1 },
                  "from": {
                    "type": "array",
                    "items": { "$ref": "common.schema.json#/$defs/refSkill" },
                    "minItems": 2,
                    "uniqueItems": true
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["text"],
                "properties": {
                  "text": { "$ref": "common.schema.json#/$defs/i18nKey" },
                  "count": { "type": "integer", "minimum": 1 }
                }
              }
            ]
          }
        },
        "lore": { "$ref": "common.schema.json#/$defs/i18nKey" },
        "feat": { "$ref": "common.schema.json#/$defs/refFeat" }
      }
    }
  ],
  "unevaluatedProperties": false
}
