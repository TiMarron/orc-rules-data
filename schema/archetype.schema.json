{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "archetype.schema.json",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    },
    {
      "type": "object",
      "required": [
        "feats"
      ],
      "properties": {
        "type": {
          "const": "archetype"
        },
        "class": {
          "$ref": "common.schema.json#/$defs/refClass",
          "$comment": "Set on a multiclass archetype only: the class of the same name. A member of that class cannot take the archetype's dedication feat."
        },
        "feats": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "level",
              "feat"
            ],
            "properties": {
              "level": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20,
                "$comment": "The level the archetype offers the feat at: the feat's own, or the one the book's Additional Feats list prints for it."
              },
              "feat": {
                "$ref": "common.schema.json#/$defs/refFeat"
              }
            }
          },
          "$comment": "Every feat of the archetype as the book lists it, the dedication included. A feat can belong to several archetypes."
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
