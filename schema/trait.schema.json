{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trait.schema.json",
  "type": "object",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/envelope" },
    {
      "type": "object",
      "properties": {
        "type": { "const": "trait" },
        "identifiedBy": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/refSkill" },
          "$comment": "The skills the Creature Identification Skills table prints for a creature with this trait, in print order. Only the creature traits that table lists carry it."
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
