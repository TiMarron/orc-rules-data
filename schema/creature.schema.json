{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "creature.schema.json",
  "$defs": {
    "key": { "$ref": "common.schema.json#/$defs/i18nKey" },
    "slug": { "$ref": "common.schema.json#/$defs/slug" },
    "feet": { "type": "integer", "minimum": 0, "multipleOf": 5 },
    "acuity": { "enum": ["precise", "imprecise", "vague"] },
    "section": { "enum": ["top", "defense", "offense"], "$comment": "The three zones of a printed stat block: above the first rule, the defences, the offence." },
    "traits": { "type": "array", "items": { "$ref": "#/$defs/slug" }, "uniqueItems": true },
    "traitValues": { "type": "object", "minProperties": 1, "propertyNames": { "$ref": "#/$defs/slug" }, "additionalProperties": { "type": "string", "minLength": 1 } },
    "valued": {
      "type": "object", "additionalProperties": false, "required": ["value"],
      "properties": { "value": { "type": "integer" }, "note": { "$ref": "#/$defs/key" } }
    },
    "typed": {
      "type": "object", "additionalProperties": false, "required": ["type", "value"],
      "properties": {
        "type": { "$ref": "#/$defs/slug" },
        "value": { "type": "integer", "minimum": 1 },
        "except": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/slug" }, "uniqueItems": true, "$comment": "What bypasses the resistance (or weakness): damage types, materials, traits (adamantine, slashing, ghost-touch), when the book prints a plain list. A qualification that is not a plain list (\"double resistance vs. non-magical\", \"magical silver\") stays in `note`." },
        "note": { "$ref": "#/$defs/key" }
      }
    },
    "modifier": {
      "oneOf": [
        { "$ref": "#/$defs/typed" },
        { "type": "object", "additionalProperties": false, "required": ["own"], "properties": { "own": { "$ref": "#/$defs/slug" } } }
      ],
      "$comment": "An entry of `weaknesses` or `resistances`: a damage type with a value, or one of this creature's own abilities (by its id) when the stat block prints that ability's name where a type and a number would go (`Weaknesses light vulnerability`) — the ability states the rule."
    },
    "sense": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["ability"], "properties": { "ability": { "$ref": "common.schema.json#/$defs/refAbility" }, "text": { "$ref": "#/$defs/key", "$comment": "What the stat block prints for it when that is more than the ability's own name: \"greater darkvision\"." }, "acuity": { "$ref": "#/$defs/acuity" }, "range": { "$ref": "#/$defs/feet" } } },
        { "type": "object", "additionalProperties": false, "required": ["own"], "properties": { "own": { "$ref": "#/$defs/slug" }, "acuity": { "$ref": "#/$defs/acuity" }, "range": { "$ref": "#/$defs/feet" } } },
        { "type": "object", "additionalProperties": false, "required": ["spell"], "properties": { "spell": { "$ref": "common.schema.json#/$defs/refSpell" }, "acuity": { "$ref": "#/$defs/acuity" }, "range": { "$ref": "#/$defs/feet" } }, "$comment": "A sense a spell gives the creature: truesight, see the unseen, detect magic." },
        { "type": "object", "additionalProperties": false, "required": ["text"], "properties": { "text": { "$ref": "#/$defs/key" }, "acuity": { "$ref": "#/$defs/acuity" }, "range": { "$ref": "#/$defs/feet" } } }
      ]
    },
    "spellRank": { "type": "integer", "minimum": 1, "maximum": 10 },
    "spellEntry": {
      "type": "object", "additionalProperties": false, "required": ["spell"],
      "properties": {
        "spell": { "$ref": "common.schema.json#/$defs/refSpell" },
        "count": { "type": "integer", "minimum": 2, "$comment": "\"(×2)\": the creature has the spell this many times a day. Absent means once." },
        "atWill": { "const": true, "$comment": "\"(at will)\"." },
        "note": { "$ref": "#/$defs/key", "$comment": "A restriction as printed: \"self only\", \"animals only\", \"see soul covenant\"." }
      },
      "not": { "properties": { "count": true, "atWill": true }, "required": ["count", "atWill"] },
      "$comment": "A spell is cast at will or so many times a day: `count` and `atWill` are not both there."
    },
    "spellList": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/spellEntry" } },
    "spellsByRank": {
      "type": "object", "additionalProperties": false, "required": ["rank", "spells"],
      "properties": { "rank": { "$ref": "#/$defs/spellRank" }, "spells": { "$ref": "#/$defs/spellList" } },
      "$comment": "One printed line of a block: \"3rd\", \"Constant (5th)\"."
    },
    "spellsWithSlots": {
      "type": "object", "additionalProperties": false, "required": ["rank", "spells"],
      "properties": { "rank": { "$ref": "#/$defs/spellRank" }, "spells": { "$ref": "#/$defs/spellList" }, "slots": { "type": "integer", "minimum": 1, "$comment": "\"(2 slots)\": how many times a day the creature casts a spell of this rank, whichever it picks from the list." } }
    },
    "spellCantrips": {
      "type": "object", "additionalProperties": false, "required": ["rank", "spells"],
      "properties": { "rank": { "$ref": "#/$defs/spellRank", "$comment": "The rank the cantrips are heightened to: \"Cantrips (3rd)\"." }, "spells": { "$ref": "#/$defs/spellList" } }
    },
    "spellsSomewhere": {
      "type": "object",
      "anyOf": [
        { "properties": { "cantrips": true }, "required": ["cantrips"] },
        { "properties": { "ranks": true }, "required": ["ranks"] },
        { "properties": { "constant": true }, "required": ["constant"] }
      ],
      "$comment": "A block that lists no spell at all is not a block."
    },
    "spellBlock": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "name", "focusPoints", "dc"],
          "allOf": [{ "$ref": "#/$defs/spellsSomewhere" }],
          "properties": {
            "kind": { "const": "focus" },
            "name": { "$ref": "#/$defs/key", "$comment": "The block's printed name: \"Cleric Domain Spells\". A focus block has no tradition of its own in the stat block." },
            "focusPoints": { "type": "integer", "minimum": 1 },
            "dc": { "type": "integer", "minimum": 1 }, "attack": { "type": "integer" },
            "cantrips": { "$ref": "#/$defs/spellCantrips" },
            "ranks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/spellsByRank" } },
            "constant": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/spellsByRank" } }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "tradition", "dc"],
          "allOf": [{ "$ref": "#/$defs/spellsSomewhere" }],
          "properties": {
            "kind": { "enum": ["innate", "prepared"] },
            "tradition": { "$ref": "common.schema.json#/$defs/tradition" },
            "dc": { "type": "integer", "minimum": 1 }, "attack": { "type": "integer" },
            "cantrips": { "$ref": "#/$defs/spellCantrips" },
            "ranks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/spellsByRank" } },
            "constant": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/spellsByRank" } }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "tradition", "dc"],
          "allOf": [{ "$ref": "#/$defs/spellsSomewhere" }],
          "properties": {
            "kind": { "const": "spontaneous" },
            "tradition": { "$ref": "common.schema.json#/$defs/tradition" },
            "dc": { "type": "integer", "minimum": 1 }, "attack": { "type": "integer" },
            "cantrips": { "$ref": "#/$defs/spellCantrips" },
            "ranks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/spellsWithSlots" } },
            "constant": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/spellsByRank" } }
          }
        }
      ],
      "$comment": "One spellcasting block of a stat block. The three branches are the three shapes the kinds take: a focus block has a name and focus points and no tradition; the other kinds have a tradition; only a spontaneous caster's ranks carry slots."
    },
    "ritualEntry": {
      "type": "object", "additionalProperties": false,
      "oneOf": [
        { "properties": { "ritual": true }, "required": ["ritual"] },
        { "properties": { "name": true }, "required": ["name"] }
      ],
      "properties": {
        "ritual": { "$ref": "common.schema.json#/$defs/refRitual", "$comment": "The ritual's record." },
        "name": { "$ref": "#/$defs/key", "$comment": "The printed name, when the dataset has no record for the ritual (its Remaster version is printed in a book the dataset does not hold)." },
        "heightened": { "type": "integer", "minimum": 2, "maximum": 10, "$comment": "\"geas (5th)\": the rank the creature performs the ritual at, above the rank of the line the ritual stands under. The validator checks that it is." },
        "note": { "$ref": "#/$defs/key", "$comment": "A restriction as printed: \"see Skeletal Lore\"." }
      },
      "$comment": "A ritual the creature can perform: the ritual's record or, when there is none, its printed name; never both."
    },
    "ritualsByRank": {
      "type": "object", "additionalProperties": false, "required": ["rank", "rituals"],
      "properties": {
        "rank": { "$ref": "#/$defs/spellRank", "$comment": "The printed rank of the line (\"3rd\")." },
        "rituals": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ritualEntry" } }
      }
    },
    "skill": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["skill", "mod"], "properties": { "skill": { "$ref": "common.schema.json#/$defs/refSkill" }, "mod": { "type": "integer" }, "note": { "$ref": "#/$defs/key" } } },
        { "type": "object", "additionalProperties": false, "required": ["lore", "mod"], "properties": { "lore": { "$ref": "#/$defs/key" }, "mod": { "type": "integer" }, "note": { "$ref": "#/$defs/key" } } }
      ]
    },
    "plainEffect": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["ability"], "properties": { "ability": { "$ref": "common.schema.json#/$defs/refAbility" }, "text": { "$ref": "#/$defs/key", "$comment": "What the stat block prints for it when that is more than the ability's own name: \"Improved Grab\" (one universal record covers Improved Grab, Knockdown and Push), \"Push 10 feet\"." } } },
        { "type": "object", "additionalProperties": false, "required": ["own"], "properties": { "own": { "$ref": "#/$defs/slug" }, "text": { "$ref": "#/$defs/key", "$comment": "What the stat block prints for it when that is more than a pointer at the ability: the damage that comes with it, \"2d6 energy damage (see draconic bite)\"." } } },
        { "type": "object", "additionalProperties": false, "required": ["text"], "properties": { "text": { "$ref": "#/$defs/key" } } }
      ],
      "$comment": "An effect of one thing: a universal ability, one of this creature's own abilities, or text. Kept apart from `effect` so that a `choice` offers these and does not nest."
    },
    "effect": {
      "oneOf": [
        { "$ref": "#/$defs/plainEffect" },
        { "type": "object", "additionalProperties": false, "required": ["choice"], "properties": { "choice": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/plainEffect" } } }, "$comment": "The creature picks one of these when the Strike hits (\"Grab or Knockdown\")." }
      ],
      "$comment": "What a Strike does besides damage: a universal ability (with what is printed for it, when that is more than its name), one of this creature's own abilities (by its id, with what is printed for it), text the import could not place, or a choice between such effects."
    },
    "strike": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "name", "actions", "bonus", "traits", "damage"],
      "properties": {
        "kind": { "enum": ["melee", "ranged"] },
        "name": { "$ref": "#/$defs/key" },
        "actions": { "$ref": "common.schema.json#/$defs/actionCost" },
        "bonus": { "type": "integer" },
        "traits": { "$ref": "#/$defs/traits" },
        "traitValues": { "$ref": "#/$defs/traitValues" },
        "material": { "$ref": "#/$defs/slug", "$comment": "The precious material the Strike counts as (cold iron, silver, adamantine); the same slug a weakness or a resistance exception names. The book prints it among the Strike's traits although it is a material, not a trait." },
        "range": { "$ref": "#/$defs/feet", "$comment": "A ranged Strike with a flat maximum range." },
        "rangeIncrement": { "$ref": "#/$defs/feet" },
        "reload": { "type": "integer", "minimum": 0, "maximum": 3, "$comment": "Actions it takes to reload, which the book prints among the Strike's traits (\"reload 1\") although it is a weapon's statistic, not a trait." },
        "damage": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["dice", "type"],
            "properties": {
              "dice": { "type": "string", "pattern": "^[1-9][0-9]*(d(4|6|8|10|12|20)([+-][1-9][0-9]*)?)?$" },
              "type": { "anyOf": [{ "$ref": "common.schema.json#/$defs/damageType" }, { "const": "bleed" }] },
              "persistent": { "const": true },
              "splash": { "const": true, "$comment": "Splash damage: dealt to the target's surroundings besides the Strike's own damage (\"1d6 acid splash damage\")." }
            }
          },
          "$comment": "May be empty: some Strikes deal no damage and only apply an effect."
        },
        "effects": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/effect" } },
        "item": { "$ref": "common.schema.json#/$defs/refItem", "$comment": "The item the Strike is made with: one of this creature's `items` (the validator checks that it is). Absent when the Strike is a natural attack or the book names no carried item for it." }
      }
    },
    "rune": {
      "type": "object", "additionalProperties": false, "required": ["item"],
      "properties": {
        "item": { "$ref": "common.schema.json#/$defs/refItem", "$comment": "The rune's record. A grade is a record of its own (\"greater striking\" is item.striking-greater), not a variant of the base rune." }
      }
    },
    "ammunition": {
      "type": "object", "additionalProperties": false, "required": ["count"],
      "oneOf": [
        { "properties": { "item": true }, "required": ["item"] },
        { "properties": { "name": true }, "required": ["name"] }
      ],
      "properties": {
        "item": { "$ref": "common.schema.json#/$defs/refItem", "$comment": "The ammunition, when the dataset has it." },
        "name": { "$ref": "#/$defs/key", "$comment": "The printed name, when the dataset has no record for the ammunition." },
        "count": { "type": "integer", "minimum": 1 }
      },
      "$comment": "\"(20 arrows)\" after a weapon: what it fires, and how many of them the creature carries. The ammunition is named once: by its record, or by its printed name when there is none."
    },
    "carried": {
      "type": "object", "additionalProperties": false,
      "anyOf": [
        { "properties": { "item": true }, "required": ["item"] },
        { "properties": { "name": true }, "required": ["name"] }
      ],
      "dependentRequired": {
        "potency": ["item"],
        "runes": ["item"],
        "material": ["item"],
        "hardness": ["hp", "bt"],
        "hp": ["hardness", "bt"],
        "bt": ["hardness", "hp"]
      },
      "properties": {
        "item": { "$ref": "common.schema.json#/$defs/refItem" },
        "name": { "$ref": "#/$defs/key", "$comment": "The printed name, when it is not the name of the item (\"baton\" for a club) or when the book has no item for it at all (\"panpipes\")." },
        "potency": { "type": "integer", "minimum": 1, "maximum": 4, "$comment": "The \"+N\" of \"+1 striking longsword\"." },
        "runes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rune" }, "$comment": "The runes printed before the item, apart from the potency, in print order." },
        "material": { "$ref": "#/$defs/slug", "$comment": "The same vocabulary as a Strike's `material` and an `except`." },
        "count": { "type": "integer", "minimum": 2, "$comment": "\"(4)\", \"(2 doses)\". Absent means one." },
        "ammunition": { "$ref": "#/$defs/ammunition" },
        "hardness": { "type": "integer", "minimum": 0, "$comment": "A shield's statistics as the stat block prints them, all three or none." },
        "hp": { "type": "integer", "minimum": 1 },
        "bt": { "type": "integer", "minimum": 0 },
        "note": { "$ref": "#/$defs/key", "$comment": "What else the parenthesis says, as printed: \"see sidebar\", \"handheld\"." }
      },
      "$comment": "One entry of the stat block's Items line: an item of the dataset, or only a name when there is none. `potency`, `runes` and `material` belong to an entry that has `item`."
    },
    "ability": {
      "type": "object", "additionalProperties": false, "required": ["id", "section", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/slug", "$comment": "Unique within the creature; what a Strike effect or a sense points at with `own`." },
        "section": { "$ref": "#/$defs/section" },
        "name": { "$ref": "#/$defs/key" },
        "ability": { "$ref": "common.schema.json#/$defs/refAbility", "$comment": "The universal ability this entry is an instance of: Trample, or the generic Aura that an aura of the creature's own links. The entry still carries what the stat block prints for it: the action cost, the traits, and the creature's own parameters (a DC, a size) in `text`." },
        "actions": { "$ref": "common.schema.json#/$defs/actionCost" },
        "traits": { "$ref": "#/$defs/traits" },
        "traitValues": { "$ref": "#/$defs/traitValues" },
        "aura": { "$ref": "#/$defs/feet", "$comment": "Emanation radius of an ability with the aura trait." },
        "trigger": { "$ref": "#/$defs/key" },
        "frequency": { "$ref": "#/$defs/key" },
        "requirements": { "$ref": "#/$defs/key" },
        "text": { "$ref": "#/$defs/key" }
      }
    }
  },
  "type": "object",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/envelope" },
    {
      "type": "object",
      "required": ["level", "size", "perception", "languages", "skills", "attributes", "ac", "saves", "hp", "speeds", "strikes", "abilities"],
      "properties": {
        "type": { "const": "creature" },
        "level": { "type": "integer", "minimum": -1, "maximum": 25 },
        "size": { "$ref": "common.schema.json#/$defs/size", "$comment": "Never repeated in `traits`: size is a scale the rules compare, not a trait with a glossary entry." },
        "perception": {
          "type": "object", "additionalProperties": false, "required": ["mod"],
          "properties": { "mod": { "type": "integer" }, "senses": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sense" } }, "note": { "$ref": "#/$defs/key" } }
        },
        "languages": { "type": "array", "items": { "$ref": "#/$defs/slug" }, "uniqueItems": true },
        "languageNote": { "$ref": "#/$defs/key" },
        "skills": { "type": "array", "items": { "$ref": "#/$defs/skill" } },
        "attributes": {
          "type": "object", "additionalProperties": false, "required": ["str", "dex", "con", "int", "wis", "cha"],
          "properties": { "str": { "type": "integer" }, "dex": { "type": "integer" }, "con": { "type": "integer" }, "int": { "type": "integer" }, "wis": { "type": "integer" }, "cha": { "type": "integer" } }
        },
        "ac": { "$ref": "#/$defs/valued" },
        "saves": {
          "type": "object", "additionalProperties": false, "required": ["fortitude", "reflex", "will"],
          "properties": { "fortitude": { "type": "integer" }, "reflex": { "type": "integer" }, "will": { "type": "integer" }, "note": { "$ref": "#/$defs/key" } }
        },
        "hp": { "$ref": "#/$defs/valued" },
        "hardness": { "type": "integer", "minimum": 1 },
        "immunities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/slug" }, "uniqueItems": true },
        "weaknesses": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/modifier" } },
        "resistances": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/modifier" } },
        "speeds": {
          "type": "object", "additionalProperties": false,
          "anyOf": [{ "properties": { "land": true }, "required": ["land"] }, { "properties": { "fly": true }, "required": ["fly"] }, { "properties": { "swim": true }, "required": ["swim"] }, { "properties": { "climb": true }, "required": ["climb"] }, { "properties": { "burrow": true }, "required": ["burrow"] }],
          "properties": { "land": { "$ref": "#/$defs/feet" }, "fly": { "$ref": "#/$defs/feet" }, "swim": { "$ref": "#/$defs/feet" }, "climb": { "$ref": "#/$defs/feet" }, "burrow": { "$ref": "#/$defs/feet" }, "note": { "$ref": "#/$defs/key" } }
        },
        "strikes": { "type": "array", "items": { "$ref": "#/$defs/strike" } },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/carried" }, "$comment": "What the creature carries, in the order the stat block's Items line prints it. Absent when the line is." },
        "spellcasting": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/spellBlock" }, "$comment": "The stat block's spell blocks in print order. Absent for a creature that casts none." },
        "rituals": {
          "type": "object", "additionalProperties": false, "required": ["dc", "ranks"],
          "properties": {
            "dc": { "type": "integer", "minimum": 1 },
            "ranks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ritualsByRank" } }
          },
          "$comment": "The stat block's Rituals line: the DC of the rituals the creature performs and, per printed rank, which they are. Absent for a creature that performs none."
        },
        "abilities": { "type": "array", "items": { "$ref": "#/$defs/ability" } }
      }
    }
  ],
  "unevaluatedProperties": false
}
