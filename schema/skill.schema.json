{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill.schema.json",
  "type": "object",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/envelope" },
    {
      "type": "object",
      "required": ["attribute"],
      "properties": {
        "type": { "const": "skill" },
        "attribute": { "$ref": "common.schema.json#/$defs/attribute" }
      }
    }
  ],
  "unevaluatedProperties": false
}
