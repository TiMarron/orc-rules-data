{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ability.schema.json",
  "type": "object",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/envelope" },
    {
      "type": "object",
      "required": ["text"],
      "properties": {
        "type": { "const": "ability" },
        "text": { "$ref": "common.schema.json#/$defs/i18nKey" },
        "actions": { "$ref": "common.schema.json#/$defs/actionCost" },
        "trigger": { "$ref": "common.schema.json#/$defs/i18nKey" },
        "requirements": { "$ref": "common.schema.json#/$defs/i18nKey" }
      }
    }
  ],
  "unevaluatedProperties": false,
  "$comment": "A universal monster ability: the rule a stat block names without restating (Grab, Darkvision). A creature points at it and carries only its own parameters."
}
