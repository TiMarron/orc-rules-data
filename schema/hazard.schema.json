{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hazard.schema.json",
  "$defs": {
    "key": { "$ref": "common.schema.json#/$defs/i18nKey" },
    "rank": { "enum": ["trained", "expert", "master", "legendary"] },
    "stealth": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "dc": { "type": "integer", "minimum": 0 },
        "modifier": { "type": "integer" },
        "rank": { "$ref": "#/$defs/rank" },
        "note": { "$ref": "#/$defs/key", "$comment": "What follows the number and rank: 'DC 22 (expert) to notice the water spouts once the pit opens', '(or 0 if the trapdoor is disabled or broken)'." }
      },
      "oneOf": [{ "properties": { "dc": true }, "required": ["dc"] }, { "properties": { "modifier": true }, "required": ["modifier"] }]
    },
    "disableOption": {
      "type": "object", "additionalProperties": false, "required": ["text"],
      "properties": {
        "dc": { "type": "integer", "minimum": 0 },
        "skill": { "$ref": "common.schema.json#/$defs/refSkill" },
        "rank": { "$ref": "#/$defs/rank" },
        "counteract": {
          "type": "object", "additionalProperties": false, "required": ["spell", "rank", "dc"],
          "properties": {
            "spell": { "$ref": "common.schema.json#/$defs/refSpell" },
            "rank": { "type": "integer", "minimum": 1, "maximum": 10 },
            "dc": { "type": "integer", "minimum": 0 }
          }
        },
        "text": { "$ref": "#/$defs/key" }
      },
      "oneOf": [{ "properties": { "dc": true }, "required": ["dc"] }, { "properties": { "counteract": true }, "required": ["counteract"] }]
    },
    "part": {
      "type": "object", "additionalProperties": false, "required": ["hp"],
      "properties": {
        "name": { "$ref": "#/$defs/key", "$comment": "'Trapdoor', 'Spout' — absent when the book prints a bare Hardness/HP." },
        "hardness": { "type": "integer", "minimum": 0, "$comment": "Absent when the book prints HP alone (an environmental hazard such as a web)." },
        "hp": { "type": "integer", "minimum": 1 },
        "bt": { "type": "integer", "minimum": 0 },
        "note": { "$ref": "#/$defs/key", "$comment": "What the book prints after the numbers: 'per junction', 'to destroy the control panel and disable the trap'." }
      }
    },
    "effect": {
      "type": "object", "additionalProperties": false, "required": ["whole"], "minProperties": 2,
      "$comment": "The numbers the text prints: the damage the ability deals, the saving throw against it, the spell it is, the poison it carries. Only what is printed; who is hit, where, and every condition stay in the text.",
      "properties": {
        "damage": { "type": "array", "minItems": 1, "items": { "$ref": "creature.schema.json#/$defs/damagePart" }, "$comment": "What the ability deals ('deals 3d12 electricity damage'); damage an outcome or a condition deals stays in the text." },
        "save": {
          "type": "object", "additionalProperties": false, "required": ["type", "dc", "basic"],
          "properties": {
            "type": { "enum": ["fortitude", "reflex", "will"] },
            "dc": { "type": "integer", "minimum": 0 },
            "basic": { "type": "boolean", "$comment": "True only when the book prints 'basic'; otherwise the text prints the outcomes." }
          }
        },
        "spell": {
          "type": "object", "additionalProperties": false, "required": ["id"],
          "$comment": "The spell the ability is ('a 3rd-rank fireball spell', 'is targeted by cursed metamorphosis').",
          "properties": {
            "id": { "$ref": "common.schema.json#/$defs/refSpell" },
            "rank": { "type": "integer", "minimum": 1, "maximum": 10, "$comment": "Absent when the book prints none." }
          }
        },
        "affliction": {
          "type": "object", "additionalProperties": false, "required": ["save", "stages"],
          "$comment": "A poison printed in an affliction's form, shaped as an affliction record's save, onset, maximum duration and stages.",
          "properties": {
            "save": { "$ref": "affliction.schema.json#/allOf/1/properties/save" },
            "onset": { "$ref": "affliction.schema.json#/$defs/duration" },
            "maxDuration": { "$ref": "affliction.schema.json#/$defs/duration" },
            "stages": { "type": "array", "minItems": 1, "items": { "$ref": "affliction.schema.json#/$defs/stage" } }
          }
        },
        "whole": { "type": "boolean", "$comment": "True when these fields are the whole printed effect and the text adds no rule beyond who is hit and where; false when the text carries more (a push, a condition in an outcome, death at 0 HP). Says whether a reader must read the text, not whether a game can play it." }
      }
    },
    "ability": {
      "type": "object", "additionalProperties": false, "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/slug" },
        "name": { "$ref": "#/$defs/key" },
        "actions": { "$ref": "common.schema.json#/$defs/actionCost" },
        "traits": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/slug" }, "uniqueItems": true },
        "traitValues": { "$ref": "creature.schema.json#/$defs/traitValues" },
        "trigger": { "$ref": "#/$defs/key" },
        "frequency": { "$ref": "#/$defs/key" },
        "requirements": { "$ref": "#/$defs/key" },
        "text": { "$ref": "#/$defs/key" },
        "effect": { "$ref": "#/$defs/effect" }
      }
    }
  },
  "type": "object",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/envelope" },
    {
      "type": "object",
      "required": ["kind", "complexity", "level", "stealth", "disable"],
      "properties": {
        "type": { "const": "hazard" },
        "kind": { "enum": ["trap", "environmental", "haunt"] },
        "complexity": { "enum": ["simple", "complex"] },
        "level": { "type": "integer", "minimum": 0, "maximum": 28 },
        "stealth": { "$ref": "#/$defs/stealth" },
        "disable": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/disableOption" } },
        "disableNote": { "$ref": "#/$defs/key", "$comment": "Conditions after the options: 'three total successes are required to disable the trap'." },
        "ac": { "$ref": "creature.schema.json#/$defs/valued" },
        "saves": {
          "type": "object", "additionalProperties": false, "minProperties": 1,
          "properties": { "fortitude": { "type": "integer" }, "reflex": { "type": "integer" }, "will": { "type": "integer" }, "note": { "$ref": "#/$defs/key" } }
        },
        "parts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/part" } },
        "immunities": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/slug" }, "uniqueItems": true },
        "immunitiesNote": { "$ref": "#/$defs/key" },
        "weaknesses": { "type": "array", "minItems": 1, "items": { "$ref": "creature.schema.json#/$defs/modifier" } },
        "resistances": { "type": "array", "minItems": 1, "items": { "$ref": "creature.schema.json#/$defs/modifier" } },
        "speeds": { "$ref": "creature.schema.json#/allOf/1/properties/speeds" },
        "abilities": { "type": "array", "items": { "$ref": "#/$defs/ability" } },
        "strikes": { "type": "array", "items": { "$ref": "creature.schema.json#/$defs/strike" } },
        "routine": {
          "type": "object", "additionalProperties": false, "required": ["actions", "text"],
          "properties": { "actions": { "type": "integer", "minimum": 1 }, "traits": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/slug" }, "uniqueItems": true }, "text": { "$ref": "#/$defs/key" }, "effect": { "$ref": "#/$defs/effect" } }
        },
        "reset": { "$ref": "#/$defs/key" },
        "special": { "$ref": "#/$defs/key" }
      },
      "if": { "type": "object", "properties": { "complexity": { "const": "simple" } }, "required": ["complexity"] },
      "then": { "type": "object", "properties": { "routine": false } }
    }
  ],
  "unevaluatedProperties": false
}
