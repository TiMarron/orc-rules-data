{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "heritage.schema.json",
  "type": "object",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/envelope" },
    {
      "type": "object",
      "required": ["ancestry"],
      "properties": {
        "type": { "const": "heritage" },
        "ancestry": { "$ref": "common.schema.json#/$defs/refAncestry" }
      }
    }
  ],
  "unevaluatedProperties": false
}
