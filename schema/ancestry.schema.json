{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ancestry.schema.json",
  "type": "object",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/envelope" },
    {
      "type": "object",
      "required": ["hp", "size", "speed", "boosts", "flaws", "languages", "heritages"],
      "properties": {
        "type": { "const": "ancestry" },
        "hp": { "type": "integer", "minimum": 4, "maximum": 12 },
        "size": { "$ref": "common.schema.json#/$defs/size" },
        "speed": { "type": "integer", "minimum": 5, "multipleOf": 5 },
        "boosts": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/boost" } },
        "flaws": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/attribute" } },
        "languages": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/slug" }, "uniqueItems": true },
        "heritages": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/refHeritage" },
          "uniqueItems": true
        },
        "senses": {
          "type": "array",
          "items": { "enum": ["darkvision", "low-light-vision"] },
          "uniqueItems": true,
          "$comment": "Printed in the ancestry's own entry alongside hit points and speed, so it belongs with them rather than in the prose."
        },
        "grants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "text"],
            "properties": {
              "name": { "$ref": "common.schema.json#/$defs/i18nKey" },
              "text": { "$ref": "common.schema.json#/$defs/i18nKey" },
              "item": { "$ref": "common.schema.json#/$defs/refItem" }
            }
          },
          "$comment": "What the ancestry gives every member at 1st level beyond its statistics - a free item such as the dwarf's clan dagger, or an ability such as the halfling's keen eyes. A sense belongs in `senses` instead."
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
