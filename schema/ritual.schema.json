{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ritual.schema.json",
  "$defs": {
    "key": { "$ref": "common.schema.json#/$defs/i18nKey" },
    "primaryCheck": {
      "type": "object", "additionalProperties": false, "required": ["skill", "rank"],
      "properties": {
        "skill": { "$ref": "common.schema.json#/$defs/refSkill" },
        "rank": { "$ref": "common.schema.json#/$defs/proficiencyRank", "$comment": "The proficiency rank the primary caster needs in the skill." },
        "note": { "$ref": "#/$defs/key", "$comment": "A condition the book prints in the parenthesis beside the rank: \"you must be a demon\"." }
      }
    },
    "skillCheck": {
      "type": "object", "additionalProperties": false, "required": ["skill"],
      "properties": { "skill": { "$ref": "common.schema.json#/$defs/refSkill" } }
    },
    "loreCheck": {
      "type": "object", "additionalProperties": false, "required": ["lore"],
      "properties": { "lore": { "$ref": "#/$defs/key", "$comment": "The printed name of the Lore skill (\"Underworld Lore\"); a Lore has no record of its own." } }
    },
    "plainCheck": {
      "oneOf": [
        { "$ref": "#/$defs/skillCheck" },
        { "$ref": "#/$defs/loreCheck" }
      ]
    },
    "secondaryCheck": {
      "oneOf": [
        { "$ref": "#/$defs/skillCheck" },
        { "$ref": "#/$defs/loreCheck" },
        {
          "type": "object", "additionalProperties": false, "required": ["oneOf"],
          "properties": { "oneOf": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/plainCheck" } } },
          "$comment": "A check the book prints as alternatives (\"Arcana or Occultism\"): the secondary casters pick one of them."
        }
      ]
    }
  },
  "type": "object",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/envelope" },
    {
      "type": "object",
      "required": ["text", "rank", "cast", "primaryCheck"],
      "properties": {
        "type": { "const": "ritual" },
        "text": { "$ref": "common.schema.json#/$defs/i18nKey" },
        "rank": { "type": "integer", "minimum": 1, "maximum": 10 },
        "cast": { "$ref": "#/$defs/key", "$comment": "How long the ritual takes to cast, as printed: \"1 day\"." },
        "cost": { "$ref": "#/$defs/key" },
        "secondaryCasters": { "type": "integer", "minimum": 1, "$comment": "How many secondary casters the ritual needs. Absent means none." },
        "primaryCheck": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/primaryCheck" }, "$comment": "The primary caster's skill check: the primary caster uses one of these, whichever they pick." },
        "secondaryChecks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/secondaryCheck" }, "$comment": "The secondary casters' checks, each of which is attempted (or one of a choice). What a check's result does stays in `text`." },
        "range": { "$ref": "common.schema.json#/$defs/i18nKey" },
        "area": { "$ref": "common.schema.json#/$defs/i18nKey" },
        "targets": { "$ref": "common.schema.json#/$defs/i18nKey" },
        "duration": { "$ref": "common.schema.json#/$defs/i18nKey" },
        "heightened": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["level", "text"],
            "properties": {
              "level": { "type": "string", "pattern": "^(\\+[1-9]|[1-9]|10)$" },
              "text": { "$ref": "common.schema.json#/$defs/i18nKey" }
            }
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
