{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "class.schema.json",
  "type": "object",
  "$defs": {
    "rank": { "$ref": "common.schema.json#/$defs/proficiencyRank" },
    "slotRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cantrips", "ranks"],
      "properties": {
        "cantrips": { "type": "integer", "minimum": 0 },
        "ranks": {
          "type": "object",
          "propertyNames": { "pattern": "^(10|[1-9])$" },
          "additionalProperties": { "type": "integer", "minimum": 1 }
        }
      }
    }
  },
  "allOf": [
    { "$ref": "common.schema.json#/$defs/envelope" },
    {
      "type": "object",
      "required": ["keyAttribute", "hp", "proficiencies", "features", "featLevels", "skillIncreaseLevels", "attributeBoostLevels"],
      "properties": {
        "type": { "const": "class" },
        "keyAttribute": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/attribute" },
            {
              "type": "array",
              "items": { "$ref": "common.schema.json#/$defs/attribute" },
              "minItems": 2,
              "uniqueItems": true
            }
          ]
        },
        "hp": { "type": "integer", "minimum": 6, "maximum": 12 },
        "proficiencies": {
          "type": "object",
          "additionalProperties": false,
          "required": ["perception", "fortitude", "reflex", "will", "skills", "attacks", "defenses", "classDc"],
          "properties": {
            "perception": { "$ref": "#/$defs/rank" },
            "fortitude": { "$ref": "#/$defs/rank" },
            "reflex": { "$ref": "#/$defs/rank" },
            "will": { "$ref": "#/$defs/rank" },
            "spellcasting": { "$ref": "#/$defs/rank" },
        "traditions": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/tradition" },
          "minItems": 1,
          "uniqueItems": true,
          "$comment": "Which tradition the class casts. `spellcasting` says only that it casts at all, which does not tell a character builder what spell list to offer."
        },
        "traditionsVary": {
          "type": "boolean",
          "$comment": "The class has no tradition of its own: the witch's is fixed by the patron chosen at character creation."
        },
            "skills": {
              "type": "object",
              "additionalProperties": false,
              "required": ["additional", "fixed"],
              "properties": {
                "additional": { "type": "integer", "minimum": 0 },
                "fixed": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/refSkill" } },
                "choices": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["count", "from"],
                        "properties": {
                          "count": { "type": "integer", "minimum": 1 },
                          "from": {
                            "type": "array",
                            "items": { "$ref": "common.schema.json#/$defs/refSkill" },
                            "minItems": 2,
                            "uniqueItems": true
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["text"],
                        "properties": {
                          "text": { "$ref": "common.schema.json#/$defs/i18nKey" },
                          "count": { "type": "integer", "minimum": 1 }
                        }
                      }
                    ]
                  }
                }
              }
            },
            "attacks": {
              "type": "object",
              "additionalProperties": false,
              "required": ["simple", "martial", "advanced", "unarmed"],
              "properties": {
                "simple": { "$ref": "#/$defs/rank" },
                "martial": { "$ref": "#/$defs/rank" },
                "advanced": { "$ref": "#/$defs/rank" },
                "unarmed": { "$ref": "#/$defs/rank" }
              }
            },
            "defenses": {
              "type": "object",
              "additionalProperties": false,
              "required": ["unarmored", "light", "medium", "heavy"],
              "properties": {
                "unarmored": { "$ref": "#/$defs/rank" },
                "light": { "$ref": "#/$defs/rank" },
                "medium": { "$ref": "#/$defs/rank" },
                "heavy": { "$ref": "#/$defs/rank" }
              }
            },
            "classDc": { "$ref": "#/$defs/rank" }
          }
        },
        "features": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["level", "feature"],
            "properties": {
              "level": { "type": "integer", "minimum": 1, "maximum": 20 },
              "feature": { "$ref": "common.schema.json#/$defs/refFeature" }
            }
          }
        },
        "featLevels": {
          "type": "object",
          "additionalProperties": false,
          "required": ["class", "skill", "general", "ancestry"],
          "properties": {
            "class": { "$ref": "common.schema.json#/$defs/levelList" },
            "skill": { "$ref": "common.schema.json#/$defs/levelList" },
            "general": { "$ref": "common.schema.json#/$defs/levelList" },
            "ancestry": { "$ref": "common.schema.json#/$defs/levelList" }
          }
        },
        "skillIncreaseLevels": { "$ref": "common.schema.json#/$defs/levelList" },
        "attributeBoostLevels": { "$ref": "common.schema.json#/$defs/levelList" },
        "spellcasting": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "source", "tradition", "slots"],
          "properties": {
            "kind": { "enum": ["prepared", "spontaneous"] },
            "source": { "enum": ["spellbook", "list", "repertoire"] },
            "tradition": { "$ref": "common.schema.json#/$defs/tradition" },
            "slots": {
              "type": "array",
              "items": { "$ref": "#/$defs/slotRow" },
              "minItems": 20,
              "maxItems": 20,
              "$comment": "Spells per day, one row per level (index = level - 1), as the class's own table prints it. A school's curriculum slots are not in it: `curriculum` adds them."
            },
            "spellbook": {
              "type": "object",
              "additionalProperties": false,
              "required": ["initialCantrips", "initialSpells", "perLevel"],
              "properties": {
                "initialCantrips": { "type": "integer", "minimum": 0 },
                "initialSpells": { "type": "integer", "minimum": 0 },
                "perLevel": { "type": "integer", "minimum": 0 }
              },
              "$comment": "What a spellbook holds at 1st level (cantrips, and spells of the lowest rank), and how many spells each later level adds, of any rank the class has slots for."
            },
            "curriculum": {
              "type": "object",
              "additionalProperties": false,
              "required": ["cantrips", "initialSpells", "perNewRank", "extraCantripSlot", "extraSlotPerRank"],
              "properties": {
                "cantrips": { "type": "integer", "minimum": 0 },
                "initialSpells": { "type": "integer", "minimum": 0 },
                "perNewRank": { "type": "integer", "minimum": 0 },
                "extraCantripSlot": { "type": "integer", "minimum": 0 },
                "extraSlotPerRank": { "type": "integer", "minimum": 0 }
              },
              "$comment": "The rule a school's curriculum follows, the same for every school: curriculum cantrips and spells written into the spellbook at 1st level, `perNewRank` more with each new slot rank, and the extra slots that only curriculum spells may fill. A school without a curriculum gets none of it."
            }
          },
          "if": { "properties": { "source": { "const": "spellbook" } } },
          "then": { "properties": { "spellbook": true }, "required": ["spellbook"] },
          "dependentRequired": { "curriculum": ["spellbook"] },
          "$comment": "How the class casts. `kind` is prepared or spontaneous; `source` is where its castable spells come from — a spellbook, the tradition's whole list, or a repertoire (whose table this schema will gain when the first spontaneous class is imported). A class whose tradition is fixed by a character's choice (the witch, `traditionsVary`) cannot carry this block yet: `tradition` is a single required value."
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
